# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True
DEBUG=True

# Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=100000000  # 100MB in bytes

# AI Configuration
OLLAMA_MODEL=mistral
# Use simple TF-IDF embeddings that don't require external libraries
EMBEDDING_MODEL=sklearn-tfidf

# Database Configuration
DATABASE_URL=postgresql://chatty_user:chatty_pass@postgres:5432/chatty_db
# For local development without Docker, use:
# DATABASE_URL=postgresql://chatty_user:chatty_pass@localhost:5432/chatty_db
