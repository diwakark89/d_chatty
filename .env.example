# DChatty environment template
# Copy this file to .env and adjust values for your environment.

# API runtime
HOST=0.0.0.0
PORT=8000
RELOAD=True
DEBUG=True

# Upload handling
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
MAX_UPLOAD_SIZE=100000000

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000

# Model settings
# Popular model options: mistral, phi3, llama2
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=sklearn-tfidf

# Optional database URL for future integrations
DATABASE_URL=postgresql://chatty_user:change_me@localhost:5433/chatty_db

# Docker Compose service credentials (development defaults)
POSTGRES_USER=chatty_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chatty_db
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
WEBUI_SECRET_KEY=change_me
